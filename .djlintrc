{
  "indent": 2,
  "blank_line_after_tag": "load,extends,include",
  "blank_line_before_tag": "block,endblock",
  "close_void_tags": true,
  "format_css": true,
  "format_js": true,
  "ignore": "H006,H030,H031",
  "include": "H017,H035",
  "indent_css": 2,
  "indent_js": 2,
  "max_line_length": 120,
  "max_attribute_length": 70,
  "profile": "django",
  "use_gitignore": true,
  "linter_output_format": "{code} {line}:{column} {message}",
  "ignore_blocks": "raw"
}
